{
  "name": "aurora-cloudbank",
  "build": {
    "dockerfile": ".devcontainer/Dockerfile",
    "context": ".."
  },
  "postCreateCommand": "pip install -r requirements.txt || true && npm install",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ]
    }
  }
