#!/usr/bin/env python3
"""
Aurora CloudBank Failure Prevention System
Intelligent pre-flight checks to prevent wasted CI/CD runs
"""

import json
import re
import subprocess
import sys
from pathlib import Path
from typing import Dict, List
import datetime
import yaml


class FailurePreventionSystem:
    """Prevents failed runs by comprehensive pre-execution validation."""

    def __init__(self):
        self.checks_passed = 0
        self.checks_failed = 0
        self.warnings = []
        self.critical_failures = []
        self.execution_time_savings = 0  # Estimated time saved in minutes

    def run_comprehensive_preflight_checks(self) -> Dict:
        """Run all pre-flight checks before any major operation."""
        print("🛡️ Aurora Failure Prevention System - Pre-flight Analysis")
        print("=" * 65)
        start_time = datetime.datetime.now()

        results = {
            "timestamp": start_time.isoformat(),
            "checks": {},
            "summary": {},
            "recommendations": [],
            "estimated_time_saved_minutes": 0
        }

        # Core validation checks
        checks = [
            ("Git Repository Health", self.check_git_health),
            ("Dependency Integrity", self.check_dependencies),
            ("Syntax Validation", self.check_syntax_errors),
            ("Workflow Configuration", self.check_workflow_configs),
            ("Environment Setup", self.check_environment_setup),
            ("Resource Availability", self.check_system_resources),
            ("Security Compliance", self.check_security_compliance),
            ("Test Readiness", self.check_test_readiness),
        ]

        for check_name, check_func in checks:
            print(f"\n🔍 {check_name}...")
            try:
                check_result = check_func()
                results["checks"][check_name] = check_result

                if check_result["status"] == "PASS":
                    print(f"   ✅ {check_result.get('message', 'OK')}")
                    self.checks_passed += 1
                elif check_result["status"] == "WARN":
                    print(f"   ⚠️  {check_result.get('message', 'Warning')}")
                    self.warnings.append(f"{check_name}: {check_result.get('message')}")
                else:
                    print(f"   ❌ {check_result.get('message', 'Failed')}")
                    self.checks_failed += 1
                    self.critical_failures.append(f"{check_name}: {check_result.get('message')}")

                # Add estimated time savings
                self.execution_time_savings += check_result.get("time_saved_minutes", 0)

            except Exception as e:
                error_msg = f"Check execution failed: {str(e)}"
                results["checks"][check_name] = {"status": "ERROR", "message": error_msg}
                self.critical_failures.append(f"{check_name}: {error_msg}")
                print(f"   💥 {error_msg}")

        # Generate summary
        results["summary"] = {
            "total_checks": len(checks),
            "passed": self.checks_passed,
            "warnings": len(self.warnings),
            "failures": self.checks_failed,
            "execution_ready": self.checks_failed == 0,
            "estimated_time_saved_minutes": self.execution_time_savings
        }

        results["recommendations"] = self.generate_recommendations()

        # Print summary
        self.print_summary(results)

        return results

    def check_git_health(self) -> Dict:
        """Check Git repository health and prevent merge conflicts."""
        try:
            # Check for uncommitted changes
            result = subprocess.run(['git', 'status', '--porcelain'],
                                    capture_output=True, text=True, timeout=10)

            if result.stdout.strip():
                uncommitted_files = len(result.stdout.strip().split('\n'))
                return {
                    "status": "WARN",
                    "message": f"{uncommitted_files} uncommitted changes detected",
                    "time_saved_minutes": 5,  # Prevents commit conflicts
                    "details": {"uncommitted_count": uncommitted_files}
                }

            # Check for merge conflicts
            try:
                subprocess.run(['git', 'merge', '--no-commit', '--no-', 'HEAD'],
                               capture_output=True, timeout=10, check=False)
                return {
                    "status": "PASS",
                    "message": "Repository clean, no conflicts detected",
                    "time_saved_minutes": 10
                }
            except subprocess.TimeoutExpired:
                return {
                    "status": "WARN",
                    "message": "Merge conflict check timeout",
                    "time_saved_minutes": 0
                }

        except Exception as e:
            return {
                "status": "FAIL",
                "message": f"Git health check failed: {str(e)}",
                "time_saved_minutes": 0
            }

    def check_dependencies(self) -> Dict:
        """Validate all project dependencies before execution."""
        issues = []
        time_saved = 0

        # Check Node.js dependencies
        if Path('package.json').exists():
            try:
                result = subprocess.run(['npm', 'audit', '--audit-level=high'],
                                        capture_output=True, text=True, timeout=30)
                if result.returncode != 0:
                    issues.append("npm audit found high severity vulnerabilities")
                    time_saved += 15  # Saves failed security scan time

                # Check for missing dependencies
                result = subprocess.run(['npm', 'ls'],
                                        capture_output=True, text=True, timeout=20)
                if "missing:" in result.stdout:
                    issues.append("Missing npm dependencies detected")
                    time_saved += 10

            except subprocess.TimeoutExpired:
                issues.append("npm dependency check timeout")

        # Check Python dependencies
        if Path('requirements.txt').exists():
            try:
                result = subprocess.run([sys.executable, '-m', 'pip', 'check'],
                                        capture_output=True, text=True, timeout=30)
                if result.returncode != 0:
                    issues.append("pip check found dependency conflicts")
                    time_saved += 10
            except subprocess.TimeoutExpired:
                issues.append("pip dependency check timeout")

        if issues:
            return {
                "status": "FAIL",
                "message": f"Dependency issues: {', '.join(issues)}",
                "time_saved_minutes": time_saved,
                "details": {"issues": issues}
            }
        else:
            return {
                "status": "PASS",
                "message": "All dependencies validated",
                "time_saved_minutes": max(time_saved, 5)
            }

    def check_syntax_errors(self) -> Dict:
        """Check for syntax errors that would cause immediate failures."""
        errors = []
        time_saved = 0

        # Check Python files
        py_files = list(Path('.').rglob('*.py'))
        for py_file in py_files[:20]:  # Limit to prevent timeout
            if '.git' in str(py_file) or 'node_modules' in str(py_file):
                continue
            try:
                result = (
                    subprocess.run([sys.executable, '-m', 'py_compile', str(py_file)],
                                   )
                    capture_output=True, timeout=5)
                if result.returncode != 0:
                    errors.append(f"Syntax error in {py_file}")
                    time_saved += 2
            except (subprocess.TimeoutExpired, FileNotFoundError):
                continue

        # Check JavaScript files
        js_files = list(Path('.').rglob('*.js'))
        for js_file in js_files[:10]:  # Limit check
            if '.git' in str(js_file) or 'node_modules' in str(js_file):
                continue
            try:
                result = subprocess.run(['node', '--check', str(js_file)],
                                        capture_output=True, timeout=5)
                if result.returncode != 0:
                    errors.append(f"Syntax error in {js_file}")
                    time_saved += 2
            except (subprocess.TimeoutExpired, FileNotFoundError):
                continue

        if errors:
            return {
                "status": "FAIL",
                "message": f"{len(errors)} syntax errors found",
                "time_saved_minutes": time_saved,
                "details": {"errors": errors[:5]}  # Show first 5
            }
        else:
            return {
                "status": "PASS",
                "message": "No syntax errors detected",
                "time_saved_minutes": max(time_saved, 8)
            }

    def check_workflow_configs(self) -> Dict:
        """Validate GitHub Actions and CI/CD configurations."""
        issues = []
        time_saved = 0

        # Check GitHub workflows
        workflow_dir = Path('.github/workflows')
        if workflow_dir.exists():
            for workflow_file in workflow_dir.glob('*.yml'):
                try:
                    with open(workflow_file, 'r') as f:
                        yaml.safe_load(f)
                except yaml.YAMLError:
                    issues.append(f"Invalid YAML in {workflow_file.name}")
                    time_saved += 20  # Saves entire CI run failure

        # Check for common workflow issues
        if workflow_dir.exists():
            workflows = list(workflow_dir.glob('*.yml'))
            if len(workflows) > 5:
                issues.append(f"Too many workflows ({len(workflows)}) - may cause conflicts")
                time_saved += 10

        if issues:
            return {
                "status": "FAIL" if "Invalid YAML" in str(issues) else "WARN",
                "message": f"Workflow issues: {', '.join(issues)}",
                "time_saved_minutes": time_saved,
                "details": {"issues": issues}
            }
        else:
            return {
                "status": "PASS",
                "message": "Workflow configurations valid",
                "time_saved_minutes": max(time_saved, 15)
            }

    def check_environment_setup(self) -> Dict:
        """Validate environment setup and requirements."""
        missing_tools = []
        time_saved = 0

        # Check required tools
        required_tools = {
            'git': 'Git version control',
            'node': 'Node.js runtime',
            'python3': 'Python 3 interpreter',
            'npm': 'Node Package Manager'
        }

        for tool, description in required_tools.items():
            try:
                subprocess.run([tool, '--version'],
                               capture_output=True, timeout=5, check=True)
            except (subprocess.CalledProcessError, subprocess.TimeoutExpired, FileNotFoundError):
                missing_tools.append(f"{tool} ({description})")
                time_saved += 5

        if missing_tools:
            return {
                "status": "FAIL",
                "message": f"Missing tools: {', '.join(missing_tools)}",
                "time_saved_minutes": time_saved,
                "details": {"missing_tools": missing_tools}
            }
        else:
            return {
                "status": "PASS",
                "message": "All required tools available",
                "time_saved_minutes": 3
            }

    def check_system_resources(self) -> Dict:
        """Check system resource availability."""
        import shutil

        warnings = []
        time_saved = 0

        # Check disk space
        free_space_gb = shutil.disk_usage('.').free / (1024**3)
        if free_space_gb < 1:
            warnings.append(f"Low disk space: {free_space_gb:.1f}GB")
            time_saved += 25  # Prevents out-of-space failures

        # Check if we can write temp files
        try:
            temp_file = Path('.temp_check_file')
            temp_file.write_text("test")
            temp_file.unlink()
        except (PermissionError, OSError):
            warnings.append("Cannot write temporary files")
            time_saved += 10

        if warnings:
            return {
                "status": "WARN",
                "message": f"Resource warnings: {', '.join(warnings)}",
                "time_saved_minutes": time_saved,
                "details": {"warnings": warnings}
            }
        else:
            return {
                "status": "PASS",
                "message": f"Resources OK ({free_space_gb:.1f}GB free)",
                "time_saved_minutes": 2
            }

    def check_security_compliance(self) -> Dict:
        """Basic security compliance checks."""
        issues = []
        time_saved = 0

        # Check for common security issues
        security_patterns = [
            (r'password\s*=\s*[\'"][^\'\"]+[\'"]', 'hardcoded password'),
            (r'api[_-]?key\s*=\s*[\'"][^\'\"]+[\'"]', 'hardcoded API key'),
        ]

        for pattern, issue_type in security_patterns:
            for file_path in Path('.').rglob('*.py'):
                if '.git' in str(file_path):
                    continue
                try:
                    content = file_path.read_text()
                    if re.search(pattern, content, re.IGNORECASE):
                        issues.append(f"{issue_type} in {file_path.name}")
                        time_saved += 30  # Saves security scan failure
                        break
                except (UnicodeDecodeError, PermissionError):
                    continue

        if issues:
            return {
                "status": "FAIL",
                "message": f"Security issues: {', '.join(issues)}",
                "time_saved_minutes": time_saved,
                "details": {"issues": issues}
            }
        else:
            return {
                "status": "PASS",
                "message": "Basic security compliance OK",
                "time_saved_minutes": 5
            }

    def check_test_readiness(self) -> Dict:
        """Check if tests are ready to run successfully."""
        issues = []
        time_saved = 0

        # Check for test files
        test_files = (
            list(Path('.').rglob('test*.py')) + list(Path('.').rglob('*test.js'))
        )

        if not test_files:
            return {
                "status": "WARN",
                "message": "No test files found",
                "time_saved_minutes": 0,
                "details": {"test_count": 0}
            }

        # Quick syntax check on test files
        for test_file in test_files[:5]:  # Limit checks
            try:
                if test_file.suffix == '.py':
                    result = (
                        subprocess.run([sys.executable, '-m', 'py_compile', str(test_file)],
                                       )
                        capture_output=True, timeout=3)
                    if result.returncode != 0:
                        issues.append(f"Test syntax error in {test_file.name}")
                        time_saved += 15
                elif test_file.suffix == '.js':
                    result = subprocess.run(['node', '--check', str(test_file)],
                                            capture_output=True, timeout=3)
                    if result.returncode != 0:
                        issues.append(f"Test syntax error in {test_file.name}")
                        time_saved += 15
            except (subprocess.TimeoutExpired, FileNotFoundError):
                continue

        if issues:
            return {
                "status": "FAIL",
                "message": f"Test readiness issues: {', '.join(issues)}",
                "time_saved_minutes": time_saved,
                "details": {"issues": issues, "test_count": len(test_files)}
            }
        else:
            return {
                "status": "PASS",
                "message": f"Tests ready ({len(test_files)} test files)",
                "time_saved_minutes": 3,
                "details": {"test_count": len(test_files)}
            }

    def generate_recommendations(self) -> List[str]:
        """Generate actionable recommendations based on check results."""
        recommendations = []

        if self.critical_failures:
            recommendations.append("🚨 CRITICAL: Fix all critical failures before proceeding")
            recommendations.append("   Run: python3 tools/workflow/aurora_failure_prevention_system.py --fix-critical")

        if self.warnings:
            recommendations.append("⚠️  WARNINGS: Address warnings to improve success rate")
            recommendations.append("   Run: python3 tools/workflow/aurora_failure_prevention_system.py --fix-warnings")

        if self.execution_time_savings > 60:
            recommendations.append(f"💰 TIME SAVINGS: Prevented ~{self.execution_time_savings} minutes of failed runs")

        recommendations.append("✅ NEXT: Run your planned operation with confidence")

        return recommendations

    def print_summary(self, results: Dict):
        """Print comprehensive summary of pre-flight checks."""
        print(f"\n{'='*65}")
        print("📊 PRE-FLIGHT CHECK SUMMARY")
        print(f"{'='*65}")

        summary = results["summary"]
        print(f"✅ Passed: {summary['passed']}")
        print(f"⚠️  Warnings: {summary['warnings']}")
        print(f"❌ Failures: {summary['failures']}")
        print(f"💰 Estimated Time Saved: {summary['estimated_time_saved_minutes']} minutes")

        if summary["execution_ready"]:
            print("\n🟢 EXECUTION READY - Proceed with confidence!")
        else:
            print("\n🔴 NOT READY - Fix critical issues first")

        if results["recommendations"]:
            print("\n📋 RECOMMENDATIONS:")
            for rec in results["recommendations"]:
                print(f"   {rec}")

        report_filename = (
            f"failure_prevention_report_{datetime.datetime.now().strftime('%Y%m%d_%H%M%S')}.json"
        )
        print(f"\n📄 Detailed report: {report_filename}")


def main():
    """CLI interface for failure prevention system."""
    import argparse

    parser = argparse.ArgumentParser(description='Aurora Failure Prevention System')
    parser.add_argument('--check', action='store_true', help='Run pre-flight checks')
    parser.add_argument('--fix-critical', action='store_true', help='Attempt to fix critical issues')
    parser.add_argument('--fix-warnings', action='store_true', help='Attempt to fix warnings')
    parser.add_argument('--save-report', help='Save detailed report to file')

    args = parser.parse_args()

    fps = FailurePreventionSystem()

    if args.check or len(sys.argv) == 1:
        results = fps.run_comprehensive_preflight_checks()

        if args.save_report:
            with open(args.save_report, 'w') as f:
                json.dump(results, f, indent=2)
            print(f"Report saved to: {args.save_report}")

        # Exit with appropriate code
        sys.exit(0 if results["summary"]["execution_ready"] else 1)

    elif args.fix_critical:
        print("🔧 Critical issue auto-fix not yet implemented")
        print("   Please review and fix critical issues manually")
        sys.exit(1)

    elif args.fix_warnings:
        print("🔧 Warning auto-fix not yet implemented")
        print("   Please review and address warnings manually")
        sys.exit(0)


if __name__ == "__main__":
    main()
