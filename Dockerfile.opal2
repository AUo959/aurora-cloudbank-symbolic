# Standalone OPAL2 Tool Foundry service
# TODO(#833): pin to a verified Python image digest.
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN useradd --create-home --uid 10002 opal2user

WORKDIR /app

COPY requirements-opal2.txt ./
RUN pip install --no-cache-dir -r requirements-opal2.txt

COPY modules/ ./modules/
COPY src/ ./src/
COPY static/ ./static/

RUN mkdir -p /app/cache /app/plugins \
    && chown -R opal2user:opal2user /app

USER opal2user

EXPOSE 8001

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://localhost:8001/health', timeout=4)"]

CMD ["uvicorn", "modules.opal2.api.opal2_api:app", "--host", "0.0.0.0", "--port", "8001"]
