{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "L3 Symbolic/Metaphorical Content Schema",
  "description": "Schema for L3 layer messages - allows symbolic and metaphorical content",
  "type": "object",
  "required": ["schema_version", "message_type", "content_type", "payload", "context_tag"],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Schema version in semver format"
    },
    "message_type": {
      "type": "string",
      "const": "l3_symbolic",
      "description": "Must be 'l3_symbolic' for L3 layer"
    },
    "content_type": {
      "type": "string",
      "enum": [
        "symbolic_metaphor",
        "narrative_expression",
        "abstract_concept",
        "poetic_insight",
        "philosophical_query",
        "axiom_evaluation",
        "ethics_consideration",
        "lore_fragment"
      ],
      "description": "Type of symbolic/metaphorical content"
    },
    "payload": {
      "type": "object",
      "description": "Flexible payload allowing symbolic content",
      "properties": {
        "text": {
          "type": "string",
          "description": "Textual symbolic/metaphorical content"
        },
        "symbols": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "List of symbolic elements"
        },
        "metaphor_mapping": {
          "type": "object",
          "description": "Optional mapping of metaphors to concrete concepts"
        },
        "narrative_context": {
          "type": "string",
          "description": "Narrative or lore context"
        }
      }
    },
    "context_tag": {
      "type": "string",
      "minLength": 1,
      "description": "DLP context tag for data lineage tracking"
    },
    "anchor_id": {
      "type": "string",
      "description": "T1/SRB anchor reference"
    },
    "intended_layer": {
      "type": "string",
      "enum": ["L3", "L2", "L1"],
      "description": "Target layer if this needs translation/routing"
    },
    "translation_hints": {
      "type": "object",
      "description": "Hints for translating to lower layers"
    },
    "timestamp": {
      "type": "number",
      "description": "Unix timestamp of message creation"
    },
    "request_id": {
      "type": "string",
      "description": "Unique request identifier for tracing"
    }
  },
  "additionalProperties": true
}
