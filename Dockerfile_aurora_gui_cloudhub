# Aurora GUI CloudHub Dockerfile
# TODO(#833): pin to verified SHA256 digest
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# Install curl for the healthcheck. The GUI runtime is FastAPI-only.
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Create a non-root user to run the service
RUN useradd -m -u 10001 clouduser

# Set working directory
WORKDIR /app

# Install dependencies
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Copy source files
COPY api/aurora_gui_cloudhub_fastapi.py ./aurora_gui_cloudhub_fastapi.py
COPY modules/ ./modules/
COPY src/ ./src/
COPY static/ ./static/

# Prepare runtime-writable directories for the non-root service user.
RUN mkdir -p uploads symbols \
    && chown -R clouduser:clouduser /app

# Use the non-root user for running the application
USER clouduser

# Expose the port
EXPOSE 8080

# Healthcheck: ensure FastAPI is up
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:8080/docs || exit 1

# Run the app
CMD ["uvicorn", "aurora_gui_cloudhub_fastapi:app", "--host", "0.0.0.0", "--port", "8080"]
