name: PR Evaluation

on:
  pull_request:
    types: [opened, synchronize, reopened]

jobs:
  evaluate:
    runs-on: ubuntu-latest
    
    steps:
    - name: Checkout code
      uses: actions/checkout@v4
      with:
        fetch-depth: 0  # Need full history for git operations

    - name: Detect first-class directory changes (gate)
      id: detect
      run: |
        BASE_SHA="${{ github.event.pull_request.base.sha }}"
        HEAD_SHA="${{ github.sha }}"
        echo "Comparing $BASE_SHA...$HEAD_SHA"
        changed=$(git diff --name-only "$BASE_SHA" "$HEAD_SHA" || true)
        echo "Changed files:\n$changed"
        should_run=false
        echo "$changed" | grep -E '^(api/|src/|tools/|tests/|modules/(hr_system|resilience_sentinel|gumas|symbolic_core|aumemmanager)/)' && should_run=true || true
        echo "should_run=$should_run" >> $GITHUB_OUTPUT
        if [ "$should_run" != "true" ]; then
          echo "No first-class directory changes detected; evaluation will be skipped."
        fi
    
    - name: Set up Python
      if: steps.detect.outputs.should_run == 'true'
      uses: actions/setup-python@v5
      with:
        python-version: '3.11'
    
    - name: Install dependencies
      if: steps.detect.outputs.should_run == 'true'
      run: |
        python -m pip install --upgrade pip
        pip install pytest flake8
        if [ -f requirements.txt ]; then pip install -r requirements.txt; fi
    
    - name: Run PR Evaluation
      if: steps.detect.outputs.should_run == 'true'
      id: evaluate
      run: |
        python3 tools/pr_evaluator.py --pr ${{ github.event.pull_request.number }} --output pr_results.json
        echo "exit_code=$?" >> $GITHUB_OUTPUT
      continue-on-error: true
    
    - name: Upload evaluation results
      if: steps.detect.outputs.should_run == 'true'
      uses: actions/upload-artifact@v4
      with:
        name: pr-evaluation-results
        path: pr_results.json
    
    - name: Install Node.js dependencies
      if: steps.detect.outputs.should_run == 'true'
      run: |
        npm install js-yaml
    
    
    - name: Comment on PR
      if: steps.detect.outputs.should_run == 'true'
      uses: actions/github-script@v7
      with:
        script: |
          const fs = require('fs');
          const AuroraBot = require('./.github/scripts/bot-helper.cjs');
          
          if (!fs.existsSync('pr_results.json')) {
            console.log('No evaluation results found, skipping comment');
            return;
          }
          
          const results = JSON.parse(fs.readFileSync('pr_results.json', 'utf8'));
          const bot = new AuroraBot(github, context);
          
          // Check if score is below threshold before commenting
          const scoreThreshold = bot.config.pr_evaluation?.comments?.score_threshold || 0.7;
          if (results.overall_score >= 0.9) {
            console.log(`Score ${results.overall_score.toFixed(2)} is excellent, skipping verbose comment`);
            
            // Just add a minimal success comment
            await bot.postComment(context.issue.number, 
              `✅ **PR Evaluation: PASSED** (Score: ${results.overall_score.toFixed(2)}/1.00)`,
              { 
                identifier: 'pr-evaluation',
                updateExisting: true 
              }
            );
            return;
          }
          
          // Build comment data
          const status = results.passed ? '✅ APPROVED' : '⚠️ NEEDS WORK';
          const statusEmoji = results.passed ? '✅' : '⚠️';
          
          // Extract critical issues only
          const criticalIssues = [];
          const recommendations = [];
          
          for (const result of results.results) {
            if (!result.passed && result.score < 0.7) {
              if (result.findings.length > 0) {
                criticalIssues.push(`**${result.category}**: ${result.findings[0]}`);
              }
              if (result.recommendations.length > 0) {
                recommendations.push(...result.recommendations.slice(0, 2));
              }
            }
          }
          
          const commentData = {
            title: 'PR Evaluation',
            status: `${status} (${results.overall_score.toFixed(2)}/1.00)`,
            statusEmoji,
            summary: results.recommendation,
            criticalIssues,
            recommendations: recommendations.slice(0, 5),
            nextSteps: criticalIssues.length > 0 ? 
              'Address the critical issues above before merging.' :
              'Review recommendations to improve code quality.'
          };
          
          const commentBody = bot.formatComment(commentData, 'actionable');
          
          await bot.postComment(context.issue.number, commentBody, {
            identifier: 'pr-evaluation',
            updateExisting: true,
            onlyOnIssues: bot.config.pr_evaluation?.comments?.only_on_issues ?? true
          });
    
    - name: Check evaluation status
      if: steps.detect.outputs.should_run == 'true' && steps.evaluate.outputs.exit_code != '0'
      run: |
        echo "PR evaluation found issues. Review the recommendations above."
        exit 1

    - name: Skip summary
      if: steps.detect.outputs.should_run != 'true'
      run: |
        echo "No first-class changes detected; PR Evaluation skipped." >> $GITHUB_STEP_SUMMARY
