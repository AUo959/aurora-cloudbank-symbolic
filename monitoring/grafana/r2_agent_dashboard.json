{
  "dashboard": {
    "title": "R-2 Agent Production Telemetry",
    "tags": ["r2-agent", "aurora", "production", "monitoring"],
    "timezone": "browser",
    "schemaVersion": 27,
    "version": 1,
    "refresh": "30s",
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "R-2 Agent Health Status",
        "type": "stat",
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 6,
          "h": 4
        },
        "targets": [
          {
            "expr": "rate(r2_agent_operations_success[5m]) / rate(r2_agent_operations_total[5m])",
            "legendFormat": "Success Rate",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": 0,
                  "color": "red"
                },
                {
                  "value": 0.8,
                  "color": "yellow"
                },
                {
                  "value": 0.95,
                  "color": "green"
                }
              ]
            },
            "unit": "percentunit"
          }
        }
      },
      {
        "id": 2,
        "title": "Total Operations",
        "type": "stat",
        "gridPos": {
          "x": 6,
          "y": 0,
          "w": 6,
          "h": 4
        },
        "targets": [
          {
            "expr": "sum(rate(r2_agent_operations_total[5m]))",
            "legendFormat": "Ops/sec",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ops"
          }
        }
      },
      {
        "id": 3,
        "title": "Detected Anomalies",
        "type": "stat",
        "gridPos": {
          "x": 12,
          "y": 0,
          "w": 6,
          "h": 4
        },
        "targets": [
          {
            "expr": "r2_agent_anomalies_detected",
            "legendFormat": "Anomalies",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": 0,
                  "color": "green"
                },
                {
                  "value": 1,
                  "color": "yellow"
                },
                {
                  "value": 10,
                  "color": "red"
                }
              ]
            }
          }
        }
      },
      {
        "id": 4,
        "title": "Average Operation Duration",
        "type": "stat",
        "gridPos": {
          "x": 18,
          "y": 0,
          "w": 6,
          "h": 4
        },
        "targets": [
          {
            "expr": "avg(r2_agent_operation_duration)",
            "legendFormat": "Avg Duration",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ms"
          }
        }
      },
      {
        "id": 5,
        "title": "Operations by Type",
        "type": "timeseries",
        "gridPos": {
          "x": 0,
          "y": 4,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "expr": "rate(r2_agent_operations_total[5m])",
            "legendFormat": "{{operation_type}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "spanNulls": true
            }
          }
        }
      },
      {
        "id": 6,
        "title": "Success vs Failure Rate",
        "type": "timeseries",
        "gridPos": {
          "x": 12,
          "y": 4,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "expr": "rate(r2_agent_operations_success[5m])",
            "legendFormat": "Success",
            "refId": "A"
          },
          {
            "expr": "rate(r2_agent_operations_errors[5m])",
            "legendFormat": "Errors",
            "refId": "B"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth"
            }
          }
        }
      },
      {
        "id": 7,
        "title": "Operation Duration Distribution",
        "type": "timeseries",
        "gridPos": {
          "x": 0,
          "y": 12,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(r2_agent_operation_duration_bucket[5m]))",
            "legendFormat": "p50",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.95, rate(r2_agent_operation_duration_bucket[5m]))",
            "legendFormat": "p95",
            "refId": "B"
          },
          {
            "expr": "histogram_quantile(0.99, rate(r2_agent_operation_duration_bucket[5m]))",
            "legendFormat": "p99",
            "refId": "C"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ms"
          }
        }
      },
      {
        "id": 8,
        "title": "Resource Usage - CPU",
        "type": "timeseries",
        "gridPos": {
          "x": 12,
          "y": 12,
          "w": 6,
          "h": 8
        },
        "targets": [
          {
            "expr": "r2_agent_resource_cpu",
            "legendFormat": "CPU %",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent"
          }
        }
      },
      {
        "id": 9,
        "title": "Resource Usage - Memory",
        "type": "timeseries",
        "gridPos": {
          "x": 18,
          "y": 12,
          "w": 6,
          "h": 8
        },
        "targets": [
          {
            "expr": "r2_agent_resource_memory",
            "legendFormat": "Memory MB",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "decmbytes"
          }
        }
      },
      {
        "id": 10,
        "title": "Error Types Distribution",
        "type": "piechart",
        "gridPos": {
          "x": 0,
          "y": 20,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "expr": "sum by (error_type) (r2_agent_operations_errors)",
            "legendFormat": "{{error_type}}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 11,
        "title": "Recent Anomalies",
        "type": "table",
        "gridPos": {
          "x": 12,
          "y": 20,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "expr": "changes(r2_agent_anomalies_detected[1h])",
            "legendFormat": "Anomaly Events",
            "refId": "A",
            "format": "table"
          }
        ]
      }
    ],
    "annotations": {
      "list": [
        {
          "datasource": "Prometheus",
          "enable": true,
          "expr": "changes(r2_agent_anomalies_detected[5m]) > 0",
          "name": "Anomaly Detected",
          "tagKeys": "anomaly_type"
        }
      ]
    },
    "templating": {
      "list": [
        {
          "name": "operation_type",
          "label": "Operation Type",
          "type": "query",
          "datasource": "Prometheus",
          "query": "label_values(r2_agent_operations_total, operation_type)",
          "multi": true,
          "includeAll": true
        }
      ]
    }
  }
}
