{
    "version": 2,
    "buildCommand": "npm ci && npm run build",
    "outputDirectory": "out",
    "framework": null,
    "installCommand": "npm ci",
    "devCommand": "npm run dev",
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "https://aurora-backend.example.com/api/:path*"
        }
    ],
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "X-Frame-Options",
                    "value": "DENY"
                },
                {
                    "key": "X-XSS-Protection",
                    "value": "1; mode=block"
                }
            ]
        }
    ],
    "env": {
        "NEXT_PUBLIC_API_BASE_URL": "https://aurora-backend.example.com",
        "NODE_ENV": "production"
    },
    "regions": [
        "iad1"
    ]
}