{
  "unit": [
    "src/**/*.py",
    "modules/**/*.py", 
    "tools/**/*.py",
    "*.py",
    "tests/test_*.py",
    "conftest.py"
  ],
  "integration": [
    "modules/*/",
    "tools/integration/",
    "scripts/",
    "tests/test_*_integration.py",
    "tests/test_opal2_*.py",
    "tests/test_native_*.py"
  ],
  "aurora-core": [
    "src/aurora/",
    "modules/symbolic_core/",
    "modules/reflective_autonomy/",
    "aurora_*.py",
    "test_aurora_*.py",
    "test_t71_*.py",
    "test_basic_functionality.py",
    "symbolic_*",
    "tools/symbolic/"
  ],
  "security": [
    "scripts/aurora_security_*.py",
    ".security/",
    "auth/",
    "crypto*.js",
    "aurora_enhanced_security.py",
    "tests/test_*security*.py",
    "encryption*",
    "*_key*"
  ],
  "api": [
    "aurora_api*.py",
    "middleware/",
    "static/",
    "templates/",
    "index.html",
    "*.html",
    "fastapi",
    "uvicorn"
  ],
  "workflow": [
    ".github/workflows/",
    ".github/scripts/",
    "tools/workflow/",
    "smart-devops",
    "package.json",
    "requirements*.txt",
    "pyproject.toml"
  ]
}