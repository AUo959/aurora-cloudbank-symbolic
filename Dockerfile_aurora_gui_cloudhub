# Aurora GUI CloudHub Dockerfile
# TODO(#833): pin to verified SHA256 digest
FROM python:3.11-slim

# Install Node.js 18.x (LTS) and curl
RUN apt-get update \
    && apt-get install -y curl \
    && curl -fsSL https://deb.nodesource.com/setup_18.x | bash - \
    && apt-get install -y nodejs \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Create a non-root user to run the service
RUN useradd -m -u 10001 clouduser

# Set working directory
WORKDIR /app

# Copy source files
COPY aurora_gui_cloudhub_fastapi.py ./
COPY requirements.txt ./

# Install dependencies
RUN pip install --no-cache-dir -r requirements.txt \
    && pip install --no-cache-dir fastapi uvicorn python-multipart

# Use the non-root user for running the application
USER clouduser

# Expose the port
EXPOSE 8080

# Healthcheck: ensure FastAPI is up
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:8080/docs || exit 1

# Run the app
CMD ["uvicorn", "aurora_gui_cloudhub_fastapi:app", "--host", "0.0.0.0", "--port", "8080"]
