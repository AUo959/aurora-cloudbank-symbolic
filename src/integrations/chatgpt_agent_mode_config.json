{
  "agent_mode_config": {
    "version": "1.0.0",
    "mode": "chatgpt_agent_mode",
    "anchor_seed": "EOS_SEED_ORION",
    "ethics_protocol": "Picard_Delta_3",
    "agent_capabilities": [
      "function_calling",
      "tool_execution", 
      "session_persistence",
      "multi_modal_interaction",
      "real_time_communication",
      "symbolic_processing",
      "quantum_vsa_operations",
      "geometric_algebra_computation",
      "command_grammar_parsing"
    ],
    "api_schema_version": "2024.1",
    "communication_protocols": {
      "rest_api": true,
      "websocket": true,
      "streaming": true,
      "function_calling": true
    },
    "tool_definitions": {
      "symbolic_processing": {
        "type": "function",
        "description": "Execute symbolic processing operations with Aurora's quantum-enhanced engine",
        "parameters": {
          "operation": "string",
          "data": "object",
          "anchor_context": "string"
        }
      },
      "quantum_vsa": {
        "type": "function", 
        "description": "Perform Vector Symbolic Architecture operations",
        "parameters": {
          "vectors": "array",
          "operation": "string",
          "dimension": "integer"
        }
      },
      "geometric_algebra": {
        "type": "function",
        "description": "Execute geometric algebra computations",
        "parameters": {
          "expression_a": "string",
          "expression_b": "string", 
          "operation": "string"
        }
      },
      "aurora_command_grammar": {
        "type": "function",
        "description": "Parse and validate Aurora command strings with //. execution enforcement",
        "parameters": {
          "command_text": "string",
          "validate": "boolean"
        }
      },
      "session_state": {
        "type": "function",
        "description": "Manage agent session state and context persistence",
        "parameters": {
          "action": "string",
          "session_id": "string",
          "state_data": "object"
        }
      }
    },
    "session_management": {
      "persistence_enabled": true,
      "max_session_duration": "24h",
      "state_backup_interval": "5m",
      "memory_sealing": true
    },
    "error_handling": {
      "graceful_degradation": true,
      "fallback_responses": true,
      "error_logging": true,
      "recovery_protocols": ["retry", "fallback", "escalate"]
    },
    "security": {
      "input_validation": true,
      "output_sanitization": true,
      "rate_limiting": true,
      "authentication_required": false,
      "dlp_compliance": "DLP_L1_OK"
    }
  },
  "integration_endpoints": {
    "/agent/tools": {
      "method": "GET",
      "description": "Discover available agent tools and capabilities"
    },
    "/agent/execute": {
      "method": "POST", 
      "description": "Execute agent tool functions with validated parameters"
    },
    "/agent/session": {
      "method": "POST",
      "description": "Manage agent session state and persistence"
    },
    "/agent/stream": {
      "method": "GET",
      "description": "WebSocket endpoint for real-time agent communication",
      "protocol": "websocket"
    },
    "/agent/status": {
      "method": "GET",
      "description": "Get current agent system status and health"
    }
  },
  "dlp_tracking": {
    "enabled": true,
    "context_tag_required": true,
    "anchor_protocol_enforcement": true,
    "symbolic_hash_validation": true
  }
}
