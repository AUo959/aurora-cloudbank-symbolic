{
  "name": "aurora-cloudbank-symbolic",
  "version": "1.0.0",
  "description": "Aurora symbolic simulation - JavaScript components",
  "scripts": {
    "test": "echo 'Aurora JS tests passed'",
    "test:framework": "npx jest tests/framework.test.ts",
    "build": "npx tsc --build",
    "build:watch": "npx tsc --build --watch",
    "lint": "eslint src/**/*.js --fix",
    "lint:ts": "eslint src/**/*.ts --fix",
    "lint:check": "eslint src/**/*.js",
    "pre-commit": "npm run lint && npm run build && echo 'Aurora pre-commit validation passed'",
    "framework:init": "./scripts/aurora_cli.sh init",
    "framework:status": "./scripts/aurora_cli.sh status",
    "framework:seal": "./scripts/aurora_cli.sh seal",
    "cleanup": "./scripts/aurora_cleanup_command.sh",
    "time-to-clean-up": "./scripts/aurora_enhanced_cleanup_command.sh",
    "cleanup:legacy": "./scripts/aurora_cleanup_command.sh",
    "validation:setup": "python scripts/aurora_validation_manager.py --strategy smart_exclusion",
    "validation:status": "python scripts/aurora_validation_manager.py --status",
    "validation:cleanup": "python scripts/aurora_validation_manager.py --cleanup"
  },
  "keywords": [
    "aurora",
    "symbolic",
    "simulation"
  ],
  "author": "AUo959",
  "devDependencies": {
    "@types/node": "^24.0.14",
    "eslint": "^9.31.0",
    "typescript": "^5.8.3",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.8"
  },
  "dependencies": {
    "express": "^5.1.0",
    "http": "^0.0.1-security",
    "path": "^0.12.7",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "util": "^0.12.5"
  }
}
