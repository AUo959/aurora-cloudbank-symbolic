#!/bin/bash
# GitWiz Pre-commit Hook
# Ensures code quality before commits

set -e

echo "🔍 GitWiz Pre-commit Quality Check..."

# Change to repository root
cd "$(git rev-parse --show-toplevel)"

# Check if GitWiz is available
if [ ! -f "scripts/gitwiz_integrated_command.py" ]; then
    echo "❌ GitWiz not found. Skipping quality checks."
    exit 0
fi

# Run GitWiz lint scan on staged files
echo "📝 Scanning staged files..."
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(py|js|jsx|ts|tsx|md)$' || true)

if [ -z "$STAGED_FILES" ]; then
    echo "✅ No relevant files staged for commit."
    exit 0
fi

# Create temporary file list
TEMP_FILE=$(mktemp)
echo "$STAGED_FILES" > "$TEMP_FILE"

# Run quality check on staged files
echo "🔍 Running quality checks..."
python3 scripts/gitwiz_integrated_command.py lint-scan --target "$TEMP_FILE" --output summary > /tmp/gitwiz_precommit.log 2>&1

# Check results
if [ $? -eq 0 ]; then
    echo "✅ Quality checks passed!"
    
    # Optional: Auto-fix minor issues
    if [ "$GITWIZ_AUTO_FIX" = "true" ]; then
        echo "🛠️ Auto-fixing minor issues..."
        python3 scripts/gitwiz_integrated_command.py quality-check --auto-fix --no-dry-run > /dev/null 2>&1 || true
        
        # Re-stage any auto-fixed files
        for file in $STAGED_FILES; do
            if [ -f "$file" ]; then
                git add "$file"
            fi
        done
    fi
    
    rm -f "$TEMP_FILE"
    exit 0
else
    echo "❌ Quality checks failed!"
    echo "📋 Issues found:"
    cat /tmp/gitwiz_precommit.log
    echo ""
    echo "💡 To fix issues automatically, run:"
    echo "   python3 scripts/gitwiz_integrated_command.py quality-check --auto-fix"
    echo ""
    echo "⚠️  To bypass this check (not recommended), use:"
    echo "   git commit --no-verify"
    
    rm -f "$TEMP_FILE"
    exit 1
fi
