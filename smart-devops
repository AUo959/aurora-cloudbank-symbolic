#!/usr/bin/env bash
# Aurora CloudBank Smart Development Utilities
# Quick access to workflow intelligence

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# Configuration
TOOLS_DIR="tools/workflow"
REPORTS_DIR="workflow_reports"

# Create reports directory if it doesn't exist
mkdir -p "$REPORTS_DIR"

show_header() {
    echo -e "${CYAN}╔══════════════════════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║                  🧠 Aurora Smart DevOps                  ║${NC}"
    echo -e "${CYAN}║              Intelligent Workflow Management            ║${NC}"
    echo -e "${CYAN}╚══════════════════════════════════════════════════════════╝${NC}"
    echo
}

quick_check() {
    echo -e "${BLUE}🚁 Quick Pre-flight Check${NC}"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    
    if python3 "$TOOLS_DIR/aurora_intelligent_workflow_manager.py" --quick; then
        echo -e "\n${GREEN}✅ All systems go! You can proceed with confidence.${NC}"
        return 0
    else
        echo -e "\n${YELLOW}⚠️  Issues detected. Run 'smart-devops full-cycle' for optimization.${NC}"
        return 1
    fi
}

full_cycle() {
    local operation="${1:-general}"
    echo -e "${PURPLE}🧠 Full Intelligent Workflow Cycle${NC}"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo -e "Operation: ${CYAN}$operation${NC}"
    echo
    
    python3 "$TOOLS_DIR/aurora_intelligent_workflow_manager.py" "$operation"
    
    # Move report to reports directory
    local latest_report=$(ls -t intelligent_workflow_report_*.json 2>/dev/null | head -1)
    if [[ -n "$latest_report" && -f "$latest_report" ]]; then
        mv "$latest_report" "$REPORTS_DIR/"
        echo -e "\n📄 Report moved to: ${BLUE}$REPORTS_DIR/$latest_report${NC}"
    fi
}

force_optimize() {
    echo -e "${YELLOW}⚡ Force Workflow Optimization${NC}"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    
    python3 "$TOOLS_DIR/aurora_workflow_optimization_manager.py"
    
    echo -e "\n${GREEN}✅ Optimization complete. Run 'smart-devops quick' to validate.${NC}"
}

security_scan() {
    echo -e "${RED}🛡️  Security & Compliance Check${NC}"  
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    
    if [[ -f "scripts/aurora_security_scanner.py" ]]; then
        python3 scripts/aurora_security_scanner.py
    else
        echo -e "${YELLOW}⚠️  Security scanner not found. Basic checks only.${NC}"
        
        # Basic security checks
        echo "Checking for obvious security issues..."
        
        # Check for hardcoded secrets
        if grep -r "password.*=" --include="*.py" --include="*.js" . | grep -v ".git" | head -3; then
            echo -e "${RED}⚠️  Potential hardcoded passwords found!${NC}"
        else
            echo -e "${GREEN}✅ No obvious hardcoded passwords${NC}"
        fi
        
        # Check for large files
        large_files=$(find . -size +50M -not -path "./.git/*" 2>/dev/null | head -5)
        if [[ -n "$large_files" ]]; then
            echo -e "${YELLOW}⚠️  Large files detected (consider Git LFS):${NC}"
            echo "$large_files"
        else
            echo -e "${GREEN}✅ No unusually large files${NC}"
        fi
    fi
}

status_dashboard() {
    echo -e "${CYAN}📊 Aurora Development Status Dashboard${NC}"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    
    # Git status
    echo -e "\n${BLUE}📂 Repository Status:${NC}"
    if git status --porcelain | wc -l | xargs test 0 -eq; then
        echo -e "   ${GREEN}✅ Repository clean${NC}"
    else
        uncommitted=$(git status --porcelain | wc -l)
        echo -e "   ${YELLOW}⚠️  $uncommitted uncommitted changes${NC}"
    fi
    
    # Workflow files
    echo -e "\n${BLUE}⚙️  Workflow Configuration:${NC}"
    if [[ -d ".github/workflows" ]]; then
        workflow_count=$(ls .github/workflows/*.yml 2>/dev/null | wc -l)
        echo -e "   📝 $workflow_count GitHub Actions workflows"
        
        if [[ $workflow_count -gt 10 ]]; then
            echo -e "   ${YELLOW}⚠️  Consider consolidating workflows${NC}"
        fi
    else
        echo -e "   ${YELLOW}📝 No GitHub workflows configured${NC}"
    fi
    
    # Dependencies
    echo -e "\n${BLUE}📦 Dependencies:${NC}"
    if [[ -f "package.json" ]]; then
        if [[ -f "package-lock.json" ]]; then
            echo -e "   ${GREEN}✅ Node.js dependencies locked${NC}"
        else
            echo -e "   ${YELLOW}⚠️  No package-lock.json (run npm install)${NC}"
        fi
    fi
    
    if [[ -f "requirements.txt" ]]; then
        echo -e "   📝 Python requirements.txt present"
    fi
    
    # System resources
    echo -e "\n${BLUE}💻 System Resources:${NC}"
    if command -v df >/dev/null 2>&1; then
        disk_usage=$(df . | awk 'NR==2 {print $5}' | sed 's/%//')
        free_space=$(df -h . | awk 'NR==2 {print $4}')
        echo -e "   💾 Disk: $disk_usage% used, $free_space available"
        
        if [[ $disk_usage -gt 90 ]]; then
            echo -e "   ${RED}⚠️  Low disk space!${NC}"
        fi
    fi
    
    # Recent reports
    echo -e "\n${BLUE}📊 Recent Reports:${NC}"
    if [[ -d "$REPORTS_DIR" ]]; then
        recent_reports=$(ls -t "$REPORTS_DIR"/*.json 2>/dev/null | head -3)
        if [[ -n "$recent_reports" ]]; then
            echo "$recent_reports" | while read -r report; do
                report_name=$(basename "$report")
                report_time=$(stat -f "%Sm" -t "%Y-%m-%d %H:%M" "$report" 2>/dev/null || stat -c "%y" "$report" 2>/dev/null | cut -d' ' -f1-2)
                echo -e "   📄 $report_name ($report_time)"
            done
        else
            echo -e "   ${YELLOW}📄 No recent reports${NC}"
        fi
    else
        echo -e "   ${YELLOW}📄 No reports directory${NC}"
    fi
}

performance_tips() {
    echo -e "${PURPLE}💡 Performance & Efficiency Tips${NC}"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo
    echo -e "${CYAN}🚀 Quick Wins:${NC}"
    echo "   • Run 'smart-devops quick' before any major operation"
    echo "   • Use 'smart-devops full-cycle deploy' before deployments"
    echo "   • Check status with 'smart-devops status' regularly"
    echo
    echo -e "${CYAN}⚡ Time Savers:${NC}"
    echo "   • Enable Git hooks: 'smart-devops setup-hooks'"
    echo "   • Use workflow caching (check optimization guides)"
    echo "   • Run security scans early: 'smart-devops security'"
    echo
    echo -e "${CYAN}🛡️  Best Practices:${NC}"
    echo "   • Commit frequently with meaningful messages"
    echo "   • Review generated optimization guides"
    echo "   • Monitor workflow execution times"
    echo "   • Address warnings before they become failures"
}

setup_git_hooks() {
    echo -e "${GREEN}🪝 Setting up Git Hooks${NC}"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    
    if [[ ! -d ".git" ]]; then
        echo -e "${RED}❌ Not a Git repository${NC}"
        return 1
    fi
    
    # Create pre-commit hook
    cat > .git/hooks/pre-commit << 'EOF'
#!/bin/bash
# Aurora CloudBank Smart Pre-commit Hook

echo "🔍 Aurora pre-commit validation..."

# Quick syntax check
if command -v python3 >/dev/null 2>&1; then
    find . -name "*.py" -not -path "./.git/*" -exec python3 -m py_compile {} \; || {
        echo "❌ Python syntax errors found"
        exit 1
    }
fi

# Basic security scan
if grep -r "password.*=" --include="*.py" --include="*.js" . | grep -v ".git" >/dev/null; then
    echo "⚠️  Warning: Potential hardcoded passwords found"
    echo "   Consider using environment variables or secure vaults"
fi

echo "✅ Pre-commit checks passed"
EOF
    
    chmod +x .git/hooks/pre-commit
    echo -e "${GREEN}✅ Pre-commit hook installed${NC}"
    
    # Create pre-push hook
    cat > .git/hooks/pre-push << 'EOF'
#!/bin/bash
# Aurora CloudBank Smart Pre-push Hook

echo "🚀 Aurora pre-push validation..."

# Run quick intelligence check
if [[ -f "tools/workflow/aurora_intelligent_workflow_manager.py" ]]; then
    if python3 tools/workflow/aurora_intelligent_workflow_manager.py --quick; then
        echo "✅ Intelligence check passed"
    else
        echo "⚠️  Intelligence check found issues - consider running optimization"
        echo "   Run: python3 tools/workflow/aurora_intelligent_workflow_manager.py"
    fi
fi

echo "✅ Pre-push checks completed"
EOF
    
    chmod +x .git/hooks/pre-push
    echo -e "${GREEN}✅ Pre-push hook installed${NC}"
}

show_usage() {
    show_header
    echo -e "${CYAN}Available Commands:${NC}"
    echo
    echo -e "  ${GREEN}quick${NC}           🚁 Quick pre-flight validation"
    echo -e "  ${GREEN}full-cycle [op]${NC}   🧠 Full intelligent workflow cycle"
    echo -e "  ${GREEN}optimize${NC}        ⚡ Force workflow optimization"
    echo -e "  ${GREEN}security${NC}        🛡️  Security & compliance scan"
    echo -e "  ${GREEN}status${NC}          📊 Development status dashboard"
    echo -e "  ${GREEN}tips${NC}            💡 Performance & efficiency tips"
    echo -e "  ${GREEN}setup-hooks${NC}     🪝 Install Git hooks for automation"
    echo -e "  ${GREEN}help${NC}            📚 Show this help message"
    echo
    echo -e "${CYAN}Examples:${NC}"
    echo -e "  ${YELLOW}smart-devops quick${NC}                    # Quick validation"
    echo -e "  ${YELLOW}smart-devops full-cycle deploy${NC}        # Pre-deployment cycle"
    echo -e "  ${YELLOW}smart-devops full-cycle test${NC}          # Pre-testing cycle"
    echo -e "  ${YELLOW}smart-devops status${NC}                   # Show dashboard"
    echo
    echo -e "${PURPLE}💡 Pro Tip: Run 'smart-devops quick' before any major operation!${NC}"
}

# Main command dispatcher
main() {
    case "${1:-help}" in
        "quick"|"q")
            show_header
            quick_check
            ;;
        "full-cycle"|"cycle"|"fc")
            show_header
            full_cycle "${2:-general}"
            ;;
        "optimize"|"opt")
            show_header
            force_optimize
            ;;
        "security"|"sec"|"scan")
            show_header
            security_scan
            ;;
        "status"|"st"|"dashboard")
            show_header
            status_dashboard
            ;;
        "tips"|"help-tips"|"advice")
            show_header
            performance_tips
            ;;
        "setup-hooks"|"hooks")
            show_header
            setup_git_hooks
            ;;
        "help"|"--help"|"-h"|"")
            show_usage
            ;;
        *)
            echo -e "${RED}❌ Unknown command: $1${NC}"
            echo
            show_usage
            exit 1
            ;;
    esac
}

# Execute main function with all arguments
main "$@"
