{
    "version": 2,
    "routes": [
        {
            "src": "/(.*)",
            "dest": "api/index.py"
        }
    ],
    "env": {
        "PYTHON_VERSION": "3.12"
    },
    "regions": [
        "iad1"
    ],
    "functions": {
        "api/**/*.py": {
            "runtime": "python3.12",
            "maxDuration": 60,
            "memory": 3008,
            "runtime": "python3.12"
        }
    }
}