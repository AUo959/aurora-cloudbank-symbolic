{
    "version": 2,
    "builds": [
        {
            "src": "api/index.py",
            "use": "@vercel/python"
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "api/index.py"
        }
    ],
    "env": {
        "PYTHON_VERSION": "3.12"
    },
    "regions": [
        "iad1"
    ],
    "functions": {
        "api/index.py": {
            "maxDuration": 60,
            "memory": 3008
        }
    }
}