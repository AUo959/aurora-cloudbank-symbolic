# Aurora CloudBank Symbolic - Core Runtime Dependencies
# Production-ready dependencies with security-validated versions
#
# Install: pip install -r requirements.txt
# For development: pip install -r requirements.txt -r requirements-dev.txt
# For optional features: pip install -r requirements-optional.txt

# ===================================================================
# CORE WEB FRAMEWORK
# ===================================================================
fastapi>=0.118.0                    # FastAPI web framework (updated for starlette 0.50+ compatibility)
uvicorn[standard]>=0.24.0           # ASGI server
starlette>=0.49.1                   # ASGI framework (SECURITY: Fixed GHSA-7f5h-v6xp-fcq8 - Range header DoS)
pydantic>=2.5.0                     # Data validation
python-multipart>=0.0.6             # File upload handling

# ===================================================================
# HTTP & NETWORKING
# ===================================================================
