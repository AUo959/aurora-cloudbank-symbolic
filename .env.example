
# Example environment variables for Aurora Reflective Autonomy System
# Copy to .env and fill in values as needed
#
# SECURITY NOTICE:
# - All secrets must be replaced with strong, random values before production use.
# - Use `openssl rand -hex 32` for 256-bit (64 hex) secrets.
# - Never commit real secrets to version control.

# Python backend
AURORA_SECRET_KEY=REPLACE_ME_SECURE_64_HEX  # 64 hex chars, required for cryptographic signing
AURORA_API_URL=http://localhost:8080

# CORS Configuration (comma-separated list of allowed origins)
# SECURITY: Set to specific domains in production, never use "*" with credentials
ALLOWED_CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000

# CSRF Secret Key (generate with: openssl rand -hex 32)
CSRF_SECRET_KEY=REPLACE_ME_SECURE_64_HEX  # 64 hex chars, used for CSRF HMAC

# WebSocket Authentication Token Secret (generate with: openssl rand -hex 32)
WS_AUTH_SECRET=REPLACE_ME_SECURE_64_HEX  # 64 hex chars, used for WebSocket token HMAC

# JWT Authentication Secret (generate with: openssl rand -hex 32)
# REQUIRED for OAuth2 and RBAC authentication
JWT_SECRET_KEY=REPLACE_ME_SECURE_64_HEX  # 64 hex chars, used for JWT token signing

# JWT Token Expiration Settings (optional, defaults shown)
ACCESS_TOKEN_EXPIRE_MINUTES=30  # Access token expiry in minutes
REFRESH_TOKEN_EXPIRE_DAYS=7      # Refresh token expiry in days

# Rate Limiting (SlowAPI) - per-minute caps for authentication endpoints
# Adjust based on expected load profile; keep conservative for auth abuse prevention
RATE_LIMIT_AUTH_TOKEN_PER_MIN=10    # Max /api/auth/token requests per minute per client IP
RATE_LIMIT_AUTH_REFRESH_PER_MIN=30  # Max /api/auth/refresh requests per minute per client IP
RATE_LIMIT_ENABLED=true             # Set to false to disable rate limiting system-wide (testing/heavy load)
RATE_LIMIT_KEY_STRATEGY=ip          # ip or ip_user (composite key with JWT sub when available)
REDIS_URL=                          # Optional Redis backend for distributed rate limiting (e.g., redis://localhost:6379)

# Node.js command node
COMMAND_NODE_PORT=3001

# Orion CORE Node Command Dispatcher
# Generate a 256-bit (64 hex chars) key with: openssl rand -hex 32
AES_KEY_256_HEX=REPLACE_ME_SECURE_64_HEX  # 64 hex chars, used for AES-256 encryption

# --------------------------------------------
# Additional runtime configuration (safe defaults for local dev)
# --------------------------------------------

# General runtime
AURORA_ENV=development
AURORA_LOG_LEVEL=INFO
AURORA_TIMEOUT=15
AURORA_MAX_RETRIES=3
AURORA_CACHE_TTL=300

# API base URL (alternative to AURORA_API_URL used in some modules)
# Prefer the value your deployment expects; both may be read in code paths
AURORA_BASE_URL=http://localhost:8080

# Monitoring & metrics
MONITORING_SIGNING_KEY=REPLACE_ME_DEV_MONITORING_SIGNING_KEY
MONITORING_STORAGE_DIR=.monitoring
PROMETHEUS_QUERY_URL=
PROMQL_WINDOW=5m
# Optional custom metric names (fallbacks exist if blank)
METRIC_INVOCATIONS=
METRIC_ERRORS=
METRIC_LATENCY=
METRIC_LATENCY_COUNT=
METRIC_CPU=
METRIC_MEM=
METRIC_UPTIME=
METRIC_SUCCESS_RATE=
COMPONENT_LABEL_KEY=component

# Ethics rules (path used by ethics modules)
ETHICS_RULES_PATH=./config/ethics_rules.json

# Memory Retrieval Module (MRM)
MRM_VECTOR_DIM=1536
MRM_CACHE_TTL=600
MRM_STORAGE_BACKEND=filesystem
MRM_STORAGE_PATH=.mrm

# Quantum providers — IBM
IBM_QUANTUM_TOKEN=
IBM_QUANTUM_INSTANCE=
IBM_QUANTUM_BACKEND=
IBM_QUANTUM_CHANNEL=

# Quantum providers — Azure Quantum
AZURE_QUANTUM_SUBSCRIPTION_ID=
AZURE_QUANTUM_RESOURCE_GROUP=
AZURE_QUANTUM_WORKSPACE_NAME=
AZURE_QUANTUM_LOCATION=
AZURE_QUANTUM_TARGET=

# Quantum providers — AWS Braket
AWS_REGION=
AWS_BRAKET_DEVICE_ARN=
AWS_BRAKET_S3_BUCKET=
AWS_BRAKET_S3_PREFIX=

# Internal Nexus paths
NEXUS_QUANTUM_ROOT=./nexus/quantum
NEXUS_RECURSION_ROOT=./nexus/recursion

# API / tooling tokens (leave empty for local dev)
AURORA_API_KEY=
GITHUB_TOKEN=

# CI hints (auto-set by CI providers; declared here for completeness)
CI=
GITHUB_ACTIONS=

# Optional / Misc
AIF_TOKEN=
LEDGER_KEY_PASSWORD=

# --------------------------------------------
# Reconciliation 2026-Q2 push (#821)
# These variables are referenced in code but were absent from this file.
# Defaults shown match the values in source; override only if needed.
# --------------------------------------------

# Aurora connector / MCP bridge (connector/auth/token.py, connector/transport/bridge.py)
AURORA_API_BASE_URL=http://localhost:8000       # Base URL the connector calls (required for connector)
AURORA_CONNECTOR_TOKEN=                          # Bearer token for connector → Aurora API (required, see #824)
AURORA_PILOT_SEAL=                               # Pilot continuity seal for elevated write ops (optional; see #822 for HMAC migration)
AURORA_ELEVATED_AUTH_LIMITS=false                # Set "true" to raise auth rate limits (see src/security/auth_routes.py:176)
ELEVATED_AUTH_TOKEN_PER_MIN=1000                 # Elevated /api/auth/token cap when AURORA_ELEVATED_AUTH_LIMITS=true
ELEVATED_AUTH_REFRESH_PER_MIN=2000               # Elevated /api/auth/refresh cap when AURORA_ELEVATED_AUTH_LIMITS=true

# Mesh runtime (src/mesh/live_agents.py, src/aurora/cli/mesh_cli.py)
MESH_OPENAI_MODEL=gpt-4.1-mini                   # OpenAI model used by the mesh live adapter
MESH_ROUTER_URL=http://127.0.0.1:8000            # Mesh router base URL for the CLI

# Memory Retrieval Module — runtime overrides (modules/memory_retrieval/config.py)
MRM_ANCHOR_SEED=EOS_SEED_ORION                   # Anchor seed identifier
MRM_ETHICS_PROTOCOL=Picard_Delta_3               # Ethics protocol label
MRM_MAX_RESULTS=10                               # Default top_k (see #799 token-cap follow-up)
MRM_RECENCY_DECAY_RATE=0.1                       # Recency weight decay

# Nexus multidim storage (modules/nexus/multidim/dimensional_orchestrator.py)
NEXUS_MULTIDIM_ROOT=.nexus_multidim              # Multidim storage root directory

# AI providers
OPENAI_API_KEY=                                  # OpenAI API key (used by mesh + AI core; see #774, #796)

# Playground sandbox (src/playground/sandbox.py, src/playground/storage.py)
PLAYGROUND_CPU_QUOTA=100000                      # Docker cpu_quota for sandbox containers
PLAYGROUND_MEM_LIMIT=512m                        # Docker mem_limit for sandbox containers
PLAYGROUND_PYTHON_IMAGE=python:3.11-slim         # Python image (see #833 for digest-pin policy)
PLAYGROUND_NODE_IMAGE=node:20-slim               # Node image (see #833 for digest-pin policy)
PLAYGROUND_REDIS_URL=redis://localhost:6379/0    # Redis backend for playground session storage
PLAYGROUND_SESSION_TTL=900                       # Session TTL in seconds

# Secure storage (src/core/secure_storage.py)
SECURE_STORAGE_KEY=                              # Optional pre-existing key; if blank, one is generated

# Insight Ledger startup verification (#806, #811)
AURORA_LEDGER_VERIFY_FULL=                       # "true" verifies every entry; default tail-only
AURORA_LEDGER_VERIFY_LIMIT=100                   # Tail size when not full
AURORA_LEDGER_VERIFY_FAIL_CLOSED=                # "true" raises on chain breakage; default logs
AURORA_LEDGER_SCHEMA_FAIL_CLOSED=                # "true" raises on schema_version mismatch; default degrades

# State storage roots (#813)
# Use AURORA_STATE_ROOT for a single tree (recommended for containers, e.g. /var/lib/aurora).
# Per-store overrides take precedence over AURORA_STATE_ROOT.
AURORA_STATE_ROOT=                               # Common ancestor for ledger + monitoring (default: cwd)
AURORA_LEDGER_PATH=                              # Explicit ledger dir; defaults to ${AURORA_STATE_ROOT}/ledgers or ./data/ledgers
AURORA_MONITORING_PATH=                          # Explicit monitoring dir; defaults to ${AURORA_STATE_ROOT}/monitoring or ./monitoring_data
# MONITORING_STORAGE_DIR is the legacy name and still works as an override.
