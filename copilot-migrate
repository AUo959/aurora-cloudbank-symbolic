#!/bin/bash
# 🤖 Copilot Migration Command - Simple one-liner for old codespaces
# Usage: Just tell Copilot "migrate this codespace" or "run aurora migration"

echo "🚨 Aurora CloudBank - Copilot-Triggered Migration"
echo "=============================================="
echo ""
echo "Fetching latest migration automator..."

# Download the migration script if not available locally
if [ ! -f aurora_codespace_migration_automator.sh ]; then
    echo "Downloading migration automator..."
    curl -sSL https://raw.githubusercontent.com/AUo959/aurora-cloudbank-symbolic/main/aurora_codespace_migration_automator.sh -o aurora_codespace_migration_automator.sh
    chmod +x aurora_codespace_migration_automator.sh
    echo "✅ Migration automator downloaded"
fi

# Also download the simple launcher
if [ ! -f migrate ]; then
    echo "Downloading migration launcher..."
    curl -sSL https://raw.githubusercontent.com/AUo959/aurora-cloudbank-symbolic/main/migrate -o migrate
    chmod +x migrate
    echo "✅ Migration launcher downloaded"
fi

echo ""
echo "🚀 Starting Aurora CloudBank Migration..."
echo ""

# Run the migration
./aurora_codespace_migration_automator.sh
