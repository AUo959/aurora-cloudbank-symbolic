{
  "name": "aurora-cloudbank-symbolic",
  "version": "1.0.0",
  "description": "Aurora CloudBank Symbolic Infrastructure - Intelligent workflow management and optimization",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.js",
    "test:web": "node --test tests/web/*.js",
    "lint": "eslint . --ext .js --fix",
    "lint:check": "eslint . --ext .js",
    "build": "node scripts/build-web.js",
    "build:prod": "NODE_ENV=production node scripts/build-web.js",
    "start": "node scripts/web-server.js",
    "start:web": "node scripts/web-server.js",
    "dev": "concurrently \"npm run start:web\" \"npm run lint:check\"",
    "pre-commit": "npm run lint && npm run test",
    "clean": "rm -rf logs/*.log dist/* build/*"
  },
  "keywords": [
    "aurora",
    "cloudbank",
    "symbolic",
    "infrastructure",
    "workflow",
    "automation",
    "devops",
    "web",
    "quantum",
    "vsa"
  ],
  "author": "Aurora CloudBank Development Team",
  "license": "MIT",
  "devDependencies": {
    "eslint": "^9.0.0",
    "concurrently": "^8.0.0",
    "@babel/core": "^7.22.0",
    "@babel/preset-env": "^7.22.0",
    "terser": "^5.19.0"
  },
  "dependencies": {
    "express": "^4.18.0",
    "ws": "^8.13.0",
    "cors": "^2.8.5",
    "express-rate-limit": "^8.0.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AUo959/aurora-cloudbank-symbolic.git"
  },
  "bugs": {
    "url": "https://github.com/AUo959/aurora-cloudbank-symbolic/issues"
  },
  "homepage": "https://github.com/AUo959/aurora-cloudbank-symbolic#readme"
}
