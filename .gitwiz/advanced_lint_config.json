{
  "version": "1.0.0",
  "description": "Advanced GitWiz Lint Cleanup Configuration",
  "python_tools": {
    "autopep8": {
      "enabled": true,
      "aggressive": 2,
      "max_line_length": 88,
      "ignore": ["E24", "W503"]
    },
    "isort": {
      "enabled": true,
      "profile": "black",
      "multi_line_output": 3,
      "line_length": 88,
      "known_third_party": ["flask", "requests", "pandas", "numpy"]
    },
    "black": {
      "enabled": true,
      "line_length": 88,
      "target_version": ["py311"],
      "skip_string_normalization": false
    },
    "pylint": {
      "enabled": true,
      "max_line_length": 88,
      "disable": ["C0114", "C0116", "R0903"],
      "output_format": "json"
    },
    "flake8": {
      "enabled": true,
      "max_line_length": 88,
      "ignore": ["E203", "W503", "E501"],
      "exclude": ["venv", "__pycache__", ".git"]
    },
    "bandit": {
      "enabled": true,
      "severity": "medium",
      "exclude_dirs": ["tests", "venv"]
    }
  },
  "javascript_tools": {
    "eslint": {
      "enabled": true,
      "extends": ["eslint:recommended"],
      "rules": {
        "no-console": "warn",
        "no-unused-vars": "error"
      }
    },
    "prettier": {
      "enabled": true,
      "semi": true,
      "singleQuote": false,
      "tabWidth": 2,
      "trailingComma": "es5"
    }
  },
  "markdown_tools": {
    "markdownlint": {
      "enabled": true,
      "rules": {
        "MD013": false,
        "MD033": false
      }
    },
    "prettier": {
      "enabled": true,
      "prose_wrap": "preserve"
    }
  },
  "workflow_settings": {
    "auto_fix_enabled": true,
    "severity_threshold": "warning",
    "max_execution_time": 600,
    "backup_before_fix": true,
    "excluded_patterns": [
      "*.pyc",
      "__pycache__",
      ".git",
      "node_modules",
      "venv",
      ".env",
      "*.log"
    ]
  },
  "custom_rules": {
    "require_encoding": true,
    "fix_subprocess_calls": true,
    "prefer_pathlib": true,
    "enforce_type_hints": false,
    "max_function_length": 50,
    "max_class_length": 200
  },
  "scheduling": {
    "enabled": false,
    "daily_maintenance": "02:00",
    "weekly_deep_clean": "Sunday 03:00",
    "pre_commit_hooks": true
  },
  "reporting": {
    "generate_reports": true,
    "report_format": ["json", "markdown"],
    "include_metrics": true,
    "save_history": true
  }
}
