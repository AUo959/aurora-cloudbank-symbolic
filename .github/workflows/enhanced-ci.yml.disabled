name: Enhanced CI/CD Pipeline

on:
  push:
    branches: [ main, dev ]
  pull_request:
    branches: [ main, dev ]

# Explicit permissions for security
permissions:
  contents: read
  actions: read
  checks: write
  pull-requests: write
  security-events: write

env:
  NODE_VERSION: '20.x'
  PYTHON_VERSION: '3.11'

jobs:
  # Pre-flight checks
  preflight:
    runs-on: ubuntu-latest
    outputs:
      has-package-json: ${{ steps.check-files.outputs.has-package-json }}
      has-requirements: ${{ steps.check-files.outputs.has-requirements }}
      has-tests: ${{ steps.check-files.outputs.has-tests }}
    steps:
      - uses: actions/checkout@v4
      - name: Check for files
        id: check-files
        run: |
          echo "has-package-json=$(test -f package.json && echo 'true' || echo 'false')" >> $GITHUB_OUTPUT
          echo "has-requirements=$(test -f requirements.txt && echo 'true' || echo 'false')" >> $GITHUB_OUTPUT
          echo "has-tests=$(test -d tests && echo 'true' || echo 'false')" >> $GITHUB_OUTPUT

  # Node.js CI
  node-ci:
    runs-on: ubuntu-latest
    needs: preflight
    if: needs.preflight.outputs.has-package-json == 'true'
    steps:
      - uses: actions/checkout@v4
      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: ${{ env.NODE_VERSION }}
          cache: 'npm'
      - name: Install dependencies
        run: npm ci
      - name: Run linting
        run: |
          echo "🔍 Running ESLint checks..."
          npm run lint
      - name: Run tests
        run: |
          echo "🧪 Running Node.js tests..."
          npm test

  # Python CI
  python-ci:
    runs-on: ubuntu-latest
    needs: preflight
    if: needs.preflight.outputs.has-requirements == 'true'
    steps:
      - uses: actions/checkout@v4
      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: ${{ env.PYTHON_VERSION }}
          cache: 'pip'
      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt
      - name: Lint with flake8
        continue-on-error: true
        run: |
          pip install flake8
          echo "🔍 Running critical Python syntax checks..."
          flake8 . --count --select=E9,F63,F7,F82 --show-source --statistics || echo "⚠️ Syntax errors found (non-blocking)"
          echo "🎨 Running Python style checks..."
          flake8 . --count --exit-zero --max-complexity=10 --max-line-length=127 --statistics
      - name: Run Python tests
        if: needs.preflight.outputs.has-tests == 'true'
        continue-on-error: true
        run: |
          pip install pytest
          echo "🧪 Running Python tests..."
          pytest tests/ -v || echo "⚠️ Some tests failed (non-blocking)"
      - name: Security scan
        continue-on-error: true
        run: |
          pip install bandit
          echo "🔒 Running security scan..."
          bandit -r . -f json -o bandit-report.json --severity-level medium || echo "⚠️ Security scan found issues (non-blocking)"
      - name: Upload security report
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: security-report
          path: bandit-report.json

  # Aurora-specific checks
  aurora-checks:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Validate Aurora configuration
        run: |
          # Check symbolic config
          if [ -f symbolic_config.yaml ]; then
            echo "✅ Symbolic config found"
            python -c "import yaml; yaml.safe_load(open('symbolic_config.yaml'))" || echo "::error::Invalid YAML in symbolic_config.yaml"
          fi

          # Check Sonnet 4 integration
          if [ -f modules/symbolic_core/sonnet4_integration_hub.py ]; then
            echo "✅ Sonnet 4 integration found"
          fi

          # Check devcontainer
          if [ -f devcontainer.json ]; then
            echo "✅ DevContainer config found"
            python -c "import json; json.load(open('devcontainer.json'))" || echo "::error::Invalid JSON in devcontainer.json"
          fi

  # Combined status check
  ci-success:
    runs-on: ubuntu-latest
    needs: [preflight, node-ci, python-ci, aurora-checks]
    if: always()
    steps:
      - name: Check all jobs
        run: |
          echo "Preflight: ${{ needs.preflight.result }}"
          echo "Node CI: ${{ needs.node-ci.result }}"
          echo "Python CI: ${{ needs.python-ci.result }}"
          echo "Aurora Checks: ${{ needs.aurora-checks.result }}"

          if [[ "${{ needs.preflight.result }}" == "failure" ]]; then
            echo "::error::Preflight checks failed"
            exit 1
          fi

          if [[ "${{ needs.aurora-checks.result }}" == "failure" ]]; then
            echo "::error::Aurora-specific checks failed"
            exit 1
          fi

          echo "✅ CI pipeline completed successfully"
