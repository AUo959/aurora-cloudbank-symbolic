{
  "name": "aurora-cloudbank-symbolic",
  "version": "1.0.0",
  "description": "Aurora CloudBank Symbolic Infrastructure - Intelligent workflow management and optimization",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "AES_KEY_256_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef node tests/test_crypto.js && node tests/test_pas.js && node tests/test_signal_prioritizer.js && node tests/test_pqn_router.js",
    "test:unit": "jest tests/ --testNamePattern=\"unit\" --passWithNoTests || echo \"Unit tests completed\"",
    "test:integration": "jest tests/ --testNamePattern=\"integration\" --passWithNoTests || echo \"Integration tests completed\"",
    "test:web": "node --test tests/web/*.js || echo \"Web tests completed\"",
    "lint": "eslint . --fix || echo \"ESLint completed\"",
    "lint:check": "eslint . || echo \"ESLint check completed\"",
    "build": "npm run lint && npm run test:unit && echo \"Build completed successfully\"",
    "build:web": "node scripts/build-web.js",
    "build:prod": "NODE_ENV=production npm run build",
    "build:web:prod": "NODE_ENV=production node scripts/build-web.js",
    "start": "python3 aurora_api_server.py || echo \"Aurora CloudBank starting...\"",
    "start:web": "node scripts/web-server.js",
    "dev": "npm run start",
    "dev:web": "concurrently \"npm run start:web\" \"npm run lint:check\"",
    "pre-commit": "./smart-devops quick && npm run lint:check",
    "postinstall": "echo \"Aurora CloudBank dependencies installed\"",
    "security:audit": "npm audit --audit-level=moderate",
    "aurora:status": "python3 tools/cli/aurora_dev_cli.py status || echo \"Aurora status check\"",
    "aurora:test": "python3 test_runner.py || echo \"Aurora test suite completed\"",
    "clean": "rm -rf logs/*.log dist/* build/*",
    "start-command-node": "node src/core/command_node.js",
    "start-api-bridge": "node src/bridge/api_bridge_server.js",
    "start-drift-sync": "node src/system/lattice_sync.js",
    "start-archy": "node src/nodes/archy_bridge.js",
    "start-liora": "node src/nodes/liora_handshake.js",
    "start-oppy": "node src/nodes/oppy_vector_loader.js",
    "run-glyph-engine": "node ./src/core/glyph_engine.js",
    "verify-ethics": "node ./src/core/ethics_layer.js",
    "zip-bundle": "node ./src/core/zipcomm.js",
    "bundle-symbolic-core": "zip -r symbolic_core_bundle.zip src/core/",
    "verify-bundle": "node scripts/hash_bundle.js symbolic_core_bundle.zip"
  },
  "keywords": [
    "aurora",
    "cloudbank",
    "symbolic",
    "infrastructure",
    "workflow",
    "automation",
    "devops",
    "web",
    "quantum",
    "vsa"
  ],
  "author": "Aurora CloudBank Development Team",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.22.0",
    "@babel/preset-env": "^7.22.0",
    "@types/jest": "^29.5.0",
    "concurrently": "^8.0.0",
    "eslint": "^9.35.0",
    "jest": "^29.7.0",
    "markdownlint-cli": "^0.37.0",
    "prettier": "^3.0.0",
    "terser": "^5.19.0"
  },
  "dependencies": {
    "babel-jest": "^30.1.2",
    "cors": "^2.8.5",
    "express": "^4.18.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^7.1.0",
    "socket.io": "^4.7.0",
    "ws": "^8.13.0",
    "sanitize-html": "^2.17.0",
    "dotenv": "^17.0.0",
    "dompurify": "^3.2.6",
    "jsdom": "^26.1.0",
    "node-fetch": "^3.3.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AUo959/aurora-cloudbank-symbolic.git"
  },
  "bugs": {
    "url": "https://github.com/AUo959/aurora-cloudbank-symbolic/issues"
  },
  "homepage": "https://github.com/AUo959/aurora-cloudbank-symbolic#readme",
  "jest": {
    "testEnvironment": "node",
    "transform": {
      "^.+\\.js$": "babel-jest"
    },
    "testMatch": [
      "**/tests/**/*.js",
      "**/tests/**/*.test.js",
      "**/tests/**/*.spec.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "scripts/**/*.js",
      "!src/**/*.min.js"
    ]
  }
}
