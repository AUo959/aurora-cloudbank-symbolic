{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora.example/schemas/character_identity_registry.schema.json",
  "title": "Orion character identity continuity registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_status",
    "authority_boundary",
    "entities",
    "quarantined_references"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "registry_status": {
      "const": "runtime_projection_non_authoritative"
    },
    "authority_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_repository",
        "authority_revision",
        "cloudbank_provenance_path",
        "policy"
      ],
      "properties": {
        "authority_repository": {
          "const": "AUo959/CanonRec"
        },
        "authority_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "cloudbank_provenance_path": {
          "const": "config/canon_provenance.json"
        },
        "policy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entity"
      }
    },
    "quarantined_references": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/quarantinedReference"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "path", "claim", "confidence"],
      "properties": {
        "repository": {
          "enum": ["AUo959/CanonRec", "AUo959/aurora-cloudbank-symbolic"]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "enum": ["HIGH", "MEDIUM", "LOW"]
        }
      }
    },
    "identifierAssignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identifier",
        "status",
        "sequence",
        "effective_date",
        "roster_version",
        "role",
        "division",
        "clearance",
        "sources",
        "superseded_by"
      ],
      "properties": {
        "identifier": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": ["historical", "current"]
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "effective_date": {
          "type": "string",
          "format": "date"
        },
        "roster_version": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "division": {
          "type": "string",
          "minLength": 1
        },
        "clearance": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "superseded_by": {
          "type": ["string", "null"],
          "minLength": 1
        }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_key",
        "entity_type",
        "preferred_name",
        "name_aliases",
        "current_identifier",
        "identity_confidence",
        "identity_authority",
        "identifiers"
      ],
      "properties": {
        "entity_key": {
          "type": "string",
          "pattern": "^ORION\\.ENTITY\\.[0-9]{4}$"
        },
        "entity_type": {
          "const": "human"
        },
        "preferred_name": {
          "type": "string",
          "minLength": 1
        },
        "name_aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "current_identifier": {
          "type": "string",
          "minLength": 1
        },
        "identity_confidence": {
          "enum": ["HIGH", "MEDIUM", "LOW"]
        },
        "identity_authority": {
          "$ref": "#/$defs/source"
        },
        "identifiers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/identifierAssignment"
          }
        }
      }
    },
    "quarantinedReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference",
        "normalized_reference",
        "status",
        "must_not_instantiate",
        "reason",
        "possible_referent",
        "sources"
      ],
      "properties": {
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "normalized_reference": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "quarantined_unresolved_reference"
        },
        "must_not_instantiate": {
          "const": true
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "possible_referent": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      }
    }
  }
}
