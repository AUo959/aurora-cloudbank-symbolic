{
  "cspm_configuration": {
    "platform": "AWS_Security_Hub",
    "compliance_frameworks": [
      "CIS",
      "NIST",
      "SOC2"
    ],
    "automated_remediation": true,
    "real_time_monitoring": true,
    "guardrails": {
      "prevent_public_buckets": true,
      "enforce_encryption": true,
      "require_mfa": true,
      "block_root_access": true
    },
    "scanning_frequency": "continuous",
    "alert_thresholds": {
      "critical": "immediate",
      "high": "15_minutes",
      "medium": "1_hour"
    }
  }
}