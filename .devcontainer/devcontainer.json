{
  "name": "Aurora CloudBank Symbolic - Optimized DevContainer",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
  "postCreateCommand": "bash -c 'pip install -r requirements.txt || true; npm install || true; cp .devcontainer/bashrc ~/.bashrc; git config --global user.name \"Aurora CloudBank\" || true; git config --global user.email \"aurora@cloudbank.dev\" || true; git config --global init.defaultBranch main || true; git config --global commit.gpgsign true || true; echo \"DevContainer setup complete - Aurora CloudBank ready!\"'",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.flake8",
        "ms-python.black-formatter",
        "ms-python.isort",
        "ms-python.debugpy",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-toolsai.jupyter",
        "ms-toolsai.vscode-ai",
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "eamodio.gitlens",
        "redhat.vscode-yaml",
        "yzhang.markdown-all-in-one",
        "ms-vscode.vscode-json",
        "editorconfig.editorconfig",
        "ms-azuretools.vscode-docker",
        "ms-vscode.makefile-tools",
        "streetsidesoftware.code-spell-checker",
        "christian-kohler.path-intellisense"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "terminal.integrated.profiles.linux": {
          "bash": {
            "path": "/bin/bash"
          }
        },
        "terminal.integrated.automationShell.linux": "/bin/bash",
        "terminal.integrated.shellIntegration.enabled": true,
        "git.enabled": true,
        "git.path": "/usr/bin/git",
        "git.terminalAuthentication": true,
        "terminal.integrated.inheritEnv": true,
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.linting.enabled": true,
        "python.linting.pylintEnabled": true,
        "python.linting.flake8Enabled": true,
        "python.formatting.provider": "black",
        "python.sortImports.args": ["--profile", "black"],
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
          "source.organizeImports": "explicit"
        },
        "files.associations": {
          "*.jsonc": "jsonc"
        },
        "jupyter.askForKernelRestart": false,
        "jupyter.interactiveWindow.textEditor.executeSelection": true
      }
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.11"
    },
    "ghcr.io/devcontainers/features/git:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "configureZshAsDefaultShell": false,
      "installOhMyZsh": false,
      "upgradePackages": true,
      "username": "node",
      "userUid": "automatic",
      "userGid": "automatic"
    }
  }
}
