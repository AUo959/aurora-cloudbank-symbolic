# Aurora Frontend Environment Variables

# API Configuration
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# Authentication (if using external auth service)
VITE_AUTH_DOMAIN=
VITE_AUTH_CLIENT_ID=

# Error Tracking (optional)
VITE_SENTRY_DSN=

# Analytics (optional)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=

# Feature Flags
VITE_ENABLE_ORION_STATION=true
VITE_ENABLE_QUANTUM_SIM=true
VITE_ENABLE_3D_MEMORY_VIZ=true

# Environment
VITE_ENV=development
