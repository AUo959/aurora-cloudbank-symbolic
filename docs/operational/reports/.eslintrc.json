{
  "env": {
    "es2021": true,
    "node": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": 2021,
    "sourceType": "module"
  },
  "rules": {
    "semi": ["error", "always"],
    "quotes": ["error", "single"],
    "eqeqeq": "error",
    "no-unused-vars": "warn",
    "no-undef": "error",
    "prefer-const": "error",
    "no-var": "error",
    "camelcase": "off",
    "id-length": "off",
    "indent": ["error", 2],
    "no-console": "off",
    "no-extra-semi": "error"
  },
  "globals": {
    "ORION_CORE": "readonly",
    "AURORA_CUSTOM_GPT": "readonly",
    "ZIPWIZ_PROTOCOL": "readonly"
  }
}
