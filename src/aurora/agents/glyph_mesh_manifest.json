{
  "module": "aurora.agents.glyph_mesh_controller",
  "version": "1.0.0",
  "name": "Glyph Mesh Controller",
  "description": "Multi-agent symbolic coordination via structured messaging with DLP tagging",
  "type": "coordination_infrastructure",
  "status": "stable",
  "anchors": [
    "T1",
    "SRB",
    "EOS_SEED_ORION"
  ],
  "symbolic_tags": [
    "GLYPH_MESH_CORE",
    "MULTI_AGENT_COORDINATION",
    "SYNERGY_BACKPLANE"
  ],
  "dlp": {
    "enabled": true,
    "tag_prefix": "glyph::",
    "operation_type": "glyph_mesh_message",
    "anchor_protocols": [
      "EOS_SEED_ORION"
    ],
    "t1_srb_anchors": [
      "T1",
      "SRB"
    ],
    "notes": "Glyph messages may carry sensitive narrative/state hints and should be logged but not persisted unencrypted. All messages receive automatic DLP tagging with full provenance chain."
  },
  "features": {
    "message_schema": {
      "standardized": true,
      "fields": [
        "sender",
        "recipient",
        "performative",
        "content",
        "layer_context",
        "timestamp"
      ]
    },
    "delivery_modes": [
      "direct",
      "broadcast"
    ],
    "performatives": [
      "inform",
      "request",
      "propose",
      "confirm",
      "reject",
      "query"
    ],
    "layer_contexts": [
      "L1",
      "L2",
      "L3",
      "L1/L2",
      "L2/L3",
      "L1/L2/L3"
    ],
    "exception_handling": "isolated",
    "logging": "structured_with_sanitization",
    "singleton_support": true
  },
  "security": {
    "log_injection_prevention": true,
    "handler_isolation": true,
    "audit_trail": "full_dlp_tagged",
    "external_dependencies": false,
    "encryption_recommendation": "required_for_persistence",
    "sanitization": "all_log_fields"
  },
  "performance": {
    "execution_mode": "synchronous",
    "process_model": "in_process",
    "delivery_complexity": "O(n)",
    "memory_footprint": "minimal",
    "network_overhead": "none"
  },
  "integration": {
    "synergy_dashboard": {
      "enabled": true,
      "observability": [
        "message_flow_tracking",
        "agent_coordination_visibility",
        "performance_metrics",
        "audit_trail"
      ]
    },
    "multi_agent_orchestration": true,
    "workflow_support": true
  },
  "api": {
    "core_classes": [
      "MeshMessage",
      "GlyphMeshController"
    ],
    "helper_functions": [
      "build_message",
      "get_glyph_mesh_controller"
    ],
    "controller_methods": [
      "subscribe",
      "unsubscribe",
      "publish",
      "get_stats",
      "get_dlp_manifest"
    ]
  },
  "testing": {
    "test_suite": "tests/test_glyph_mesh_controller.py",
    "test_coverage": "comprehensive",
    "test_markers": [
      "unit",
      "integration",
      "aurora",
      "critical"
    ],
    "test_count": 20
  },
  "documentation": {
    "readme": "modules/agents/README.md",
    "inline_docs": true,
    "examples": "included_in_tests",
    "api_reference": "complete"
  },
  "future_extensions": [
    "topics_channels",
    "priority_queues",
    "reply_to_fields",
    "message_filtering",
    "async_support",
    "optional_persistence"
  ],
  "dependencies": {
    "core": [
      "src.core.native_dlp_export",
      "src.core.logging_security"
    ],
    "external": [],
    "optional": []
  },
  "compatibility": {
    "python_version": ">=3.11",
    "aurora_version": ">=3.5.2",
    "zero_dependencies": true
  },
  "metadata": {
    "author": "Aurora Cloudbank Symbolic",
    "created": "2025-11-13",
    "exported_at": "2025-11-13T23:00:00Z",
    "license": "Aurora Project License",
    "repository": "AUo959/aurora-cloudbank-symbolic"
  }
}
