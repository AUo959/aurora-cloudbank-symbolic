{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "L2 Simulation Event Schema",
  "description": "Schema for L2 layer messages - simulation events with explicit event_type and structured parameters",
  "type": "object",
  "required": ["schema_version", "message_type", "event_type", "parameters", "context_tag"],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Schema version in semver format"
    },
    "message_type": {
      "type": "string",
      "const": "l2_simulation_event",
      "description": "Must be 'l2_simulation_event' for L2 layer"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "quantum_simulation",
        "symbolic_computation",
        "entity_interaction",
        "scenario_execution",
        "memory_operation",
        "drift_measurement",
        "architecture_validation",
        "solar_storm",
        "anomaly_event",
        "faction_event"
      ],
      "description": "Type of simulation event"
    },
    "parameters": {
      "type": "object",
      "description": "Event-specific parameters with structured data"
    },
    "context_tag": {
      "type": "string",
      "minLength": 1,
      "description": "DLP context tag for data lineage tracking"
    },
    "anchor_id": {
      "type": "string",
      "description": "T1/SRB anchor reference"
    },
    "lore_id": {
      "type": "string",
      "description": "Optional lore reference for narrative context"
    },
    "entity_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Entities involved in this event"
    },
    "location": {
      "type": "string",
      "description": "Station location or simulation context"
    },
    "risk_score": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Risk assessment score for the event"
    },
    "timestamp": {
      "type": "number",
      "description": "Unix timestamp of message creation"
    },
    "request_id": {
      "type": "string",
      "description": "Unique request identifier for tracing"
    }
  },
  "additionalProperties": true
}
